# Copy to .env and change these before anything real goes in.
# docker compose reads this file automatically.

POSTGRES_USER=phr
POSTGRES_PASSWORD=phr
POSTGRES_DB=phr

BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=change-me-now
HOUSEHOLD_NAME=Household

ORTHANC_USER=orthanc
ORTHANC_PASS=orthanc

# Optional. Leave empty. Model extraction stays off until you set mode in Settings.
LLM_API_KEY=
LLM_MODE=off
LLM_BASE_URL=
LLM_MODEL=
LLM_AUTOFILE=false
